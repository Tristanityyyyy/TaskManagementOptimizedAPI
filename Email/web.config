<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS / ASP.NET Core Module: enables stdout logs when the app fails to start (HTTP 500.30).
  After publish, ensure the site folder contains a "logs" directory (or IIS may create it),
  then check logs\stdout_*.log for the real exception.
  Adjust TaskManagement.dll if your output assembly name differs.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\TaskManagement.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="outofprocess" />
    </system.webServer>
  </location>
</configuration>
