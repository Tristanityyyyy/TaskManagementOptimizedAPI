<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting for the ASP.NET Core API.

  - hostingModel="inprocess" is the default for .NET 8 and avoids the 502.5
    "ANCM Out-Of-Process Startup Failure" you'll get with hostingModel="outofprocess"
    when the worker can't bind a Kestrel port behind ANCM.
  - stdoutLogEnabled="true" writes startup exceptions to .\logs\stdout_*.log so 500.30
    failures can be diagnosed. Make sure a "logs" folder exists under the site root
    (or grant write permission so ANCM can create it) and that the IIS app pool
    identity has write access.
  - Adjust TaskManagement.dll/.exe if the output assembly name ever changes.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\TaskManagement.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
